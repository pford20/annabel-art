---
import { Image } from 'astro:assets';
import { imageFor, altFor, formatPrice, shortCaption, type Piece } from '../data/work';

interface Props {
	piece: Piece;
	/** The first card on a page loads eagerly; the rest wait. */
	eager?: boolean;
}

const { piece, eager = false } = Astro.props;

// Buy appears once the piece has a Stripe link in src/data/work.ts.
// Until then the card offers Enquire instead, so nothing looks broken.
const canBuy = Boolean(piece.buyUrl);
const caption = shortCaption(piece);
const detailsHref = `/portfolio/${piece.slug}`;
const enquireHref = `/contact?piece=${encodeURIComponent(piece.title)}`;
---

{/* The selling card, used on / and /originals. Deliberately louder than the
    /portfolio gallery tile: bigger image, a price, and something to press. */}
<article class="flex flex-col">
	<a class="group block" href={detailsHref}>
		{/* Contained, so no painting is ever cropped — it sits on paper. */}
		<div class="flex aspect-[4/5] w-full items-center justify-center overflow-hidden">
			<Image
				src={imageFor(piece)}
				alt={altFor(piece)}
				width={900}
				widths={[400, 600, 900]}
				sizes="(min-width: 640px) 50vw, 100vw"
				class="h-full w-full object-contain transition-opacity duration-200 group-hover:opacity-85"
				loading={eager ? 'eager' : 'lazy'}
				decoding="async"
			/>
		</div>
	</a>

	<div class="mt-5 flex flex-1 flex-col">
		<h3 class="font-display text-2xl font-normal text-ink">
			<a class="transition-opacity hover:opacity-70" href={detailsHref}>{piece.title}</a>
		</h3>

		{caption && <p class="mt-1 text-[13px] text-stone">{caption}</p>}

		{piece.price !== undefined && <p class="mt-3 text-lg text-ink">{formatPrice(piece.price)}</p>}

		<p class="mt-1 text-[13px] text-stone">Free insured US shipping</p>

		<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:gap-4">
			{
				canBuy ? (
					<a class="btn" href={piece.buyUrl} rel="noopener">
						Buy
					</a>
				) : (
					<a class="btn" href={enquireHref}>
						Enquire
					</a>
				)
			}
			<a class="btn-secondary" href={detailsHref}>Details</a>
		</div>
	</div>
</article>
