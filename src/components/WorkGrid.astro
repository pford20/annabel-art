---
import { Image } from 'astro:assets';
import { imageFor, altFor, type Piece } from '../data/work';

interface Props {
	pieces: Piece[];
}

const { pieces } = Astro.props;
---

{/* Used by /portfolio and /originals so the two grids can't drift apart. */}
<ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
	{
		pieces.map((piece) => (
			<li>
				<a class="group block" href={`/portfolio/${piece.slug}`}>
					{/* Uniform tile so the grid stays even, but object-contain
					    means no painting is ever cropped — it sits on paper. */}
					<div class="flex aspect-[4/5] w-full items-center justify-center overflow-hidden">
						<Image
							src={imageFor(piece)}
							alt={altFor(piece)}
							width={900}
							widths={[400, 600, 900]}
							sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
							class="h-full w-full object-contain transition-opacity duration-200 group-hover:opacity-85"
							loading="lazy"
							decoding="async"
						/>
					</div>

					<div class="mt-3 flex items-baseline justify-between gap-3 text-[13px]">
						<span class="text-charcoal transition-colors group-hover:text-ink">
							{piece.title}
						</span>
						{piece.status === 'sold' && <span class="text-stone">Sold</span>}
					</div>
				</a>
			</li>
		))
	}
</ul>
