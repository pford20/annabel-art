---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Annabel Art">
	<main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-24">
		<p class="text-sm font-medium uppercase tracking-widest text-stone-500">
			Portfolio
		</p>
		<h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
			Annabel Art
		</h1>
		<p class="mt-6 max-w-prose text-lg leading-relaxed text-stone-600">
			A site under construction. Built with Astro and Tailwind CSS.
		</p>
	</main>
</Layout>
