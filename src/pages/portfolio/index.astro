---
import Layout from '../../layouts/Layout.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { galleryWork } from '../../data/work';
---

<Layout title="Portfolio" description="Paintings by Annabel — contemporary, figurative, editorial, surreal.">
	<div class="mx-auto max-w-site px-5 py-16 sm:px-12 sm:py-24">
		<h1 class="font-display text-[32px] font-light leading-[1.1] text-ink sm:text-[48px]">
			Portfolio
		</h1>

		<div class="mt-12 sm:mt-16">
			<WorkGrid pieces={galleryWork} />
		</div>
	</div>
</Layout>
