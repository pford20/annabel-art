---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prints" description="Signed, limited-edition prints from annabel art. Coming soon.">
	<div class="mx-auto max-w-site px-5 py-16 sm:px-12 sm:py-24">
		<h1 class="font-display text-[32px] font-light leading-[1.1] text-ink sm:text-[48px]">
			Prints
		</h1>

		<p class="mt-6 max-w-prose text-charcoal">
			Signed, limited-edition prints are on the way.
		</p>

		{/* The email signup is hidden until MailerLite is set up. To bring it back:
		    put back the import at the top of this file:
		        import EmailSignup from '../components/EmailSignup.astro';
		    paste this in below:
		        <div class="mt-10"><EmailSignup /></div>
		    and add "Join the list below to hear first." back onto the sentence above. */}
	</div>
</Layout>
