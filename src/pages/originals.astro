---
import Layout from '../layouts/Layout.astro';
import ShopGrid from '../components/ShopGrid.astro';
import AvailabilitySync from '../components/AvailabilitySync.astro';
import { availableWork } from '../data/work';

// Everything for sale, newest first. When the last one sells this empties
// out and the page says so on its own — nothing here needs editing.
const forSale = availableWork;
const isSelling = forSale.length > 0;

// With nothing for sale, "Available originals" would contradict the message
// underneath it.
const heading = isSelling ? 'Available originals' : 'Originals';
---

<Layout
	title={heading}
	description={
		isSelling
			? 'Original paintings by Annabel, signed by the artist. Free insured shipping in the US.'
			: 'Every current original has found a home. New work is on the way.'
	}
>
	<div class="mx-auto max-w-site px-5 py-16 sm:px-12 sm:py-24">
		<h1
			class="font-display text-[32px] font-light leading-[1.1] text-ink sm:text-[48px]"
			data-shop-heading
		>
			{heading}
		</h1>

		{/* Both states are in the page. If a painting sells mid-visit, the
		    availability check empties the grid and swaps these over without a
		    rebuild. Whichever isn't in use is hidden with an inline style, so
		    it stays hidden even if JavaScript never runs. */}
		{
			isSelling && (
				<div data-shop-section>
					<p class="mt-6 max-w-prose text-charcoal">
						Original paintings, signed by the artist. Free insured shipping in the US.
					</p>

					<div class="mt-12 sm:mt-16">
						<ShopGrid pieces={forSale} eagerFirst />
					</div>
				</div>
			)
		}

		<div data-shop-empty hidden={isSelling} style={isSelling ? 'display:none' : undefined}>
			<p class="mt-6 max-w-prose text-charcoal">
				Every current original has found a home. New work is on the way.
			</p>

			<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4">
				<a class="btn" href="/portfolio">See the portfolio</a>
				<a class="btn-secondary" href="/commissions">Commission a painting</a>
			</div>
		</div>
	</div>

	<AvailabilitySync />
</Layout>
