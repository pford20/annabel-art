---
import Layout from '../layouts/Layout.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { work } from '../data/work';

// Everything currently for sale, in the same order as the portfolio grid.
// When the last one sells this empties out and the page says so on its own —
// nothing here needs editing.
const available = work.filter((piece) => piece.status === 'available');
---

<Layout
	title="Originals"
	description={
		available.length > 0
			? 'Original paintings by Annabel, available now.'
			: 'Every current original has found a home. New work is on the way.'
	}
>
	<div class="mx-auto max-w-site px-5 py-16 sm:px-12 sm:py-24">
		<h1 class="font-display text-[32px] font-light leading-[1.1] text-ink sm:text-[48px]">
			Originals
		</h1>

		{
			available.length > 0 ? (
				<div class="mt-12 sm:mt-16">
					<WorkGrid pieces={available} />
				</div>
			) : (
				<>
					<p class="mt-6 max-w-prose text-charcoal">
						Every current original has found a home. New work is on the way.
					</p>

					<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:gap-4">
						<a class="btn" href="/portfolio">
							See the portfolio
						</a>
						<a class="btn-secondary" href="/commissions">
							Commission a painting
						</a>
					</div>
				</>
			)
		}
	</div>
</Layout>
